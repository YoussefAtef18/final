extends base

block content
  .container
    h2.special-heading Products
    p All products are handmade
    form.search-bar
      button
        i.bi.bi-search
      input#search-bar.search(type='search' placeholder='Search')
    #filter.filters
      ul
        li.list
          a(href='#' data-filter='all') All
        li.list
          a(href='#' data-filter='ACCESSORIES') Accessories
        li.list
          a(href='#' data-filter='ART') Art
        li.list
          a(href='#' data-filter='CROCET') Crocet
        li.list
          a(href='#' data-filter='COOKING') Cooking
        li.list
          a(href='#' data-filter='TAILOR') Tailor
        li.list
          a(href='#' data-filter='WOODEN') Wooden
        li.list
          a(href='#' data-filter='OTHER') Other
  .products
    each product in products
      .pro-card(data-item=`${product.category}`)
        img(src=`/images/products/${product.images[0]}` alt=`${product.title}`)
        h5.product-title= product.title
        .details
          span= `${product.price} EGP`
          if user
            if product.user._id == user.id
              a.btn-edt(href=(`/editProduct/${product.id}`)) edit
            else 
              a.btn-add
                i.bi.bi-cart3.addToCart(data-product-id=`${product.id}`) 
          else 
            a.btn-add(href='/login')
              i.bi.bi-cart3.addToCart
        a.detail(href=`/products/${product.id}`) Details
  i.fas.fa-arrow-up
  
  script(src='/jqueryLib.js')
  script.
    document.querySelectorAll('.list a').forEach(item => {
      item.addEventListener('click', function(e) {
        e.preventDefault(); // Prevent the default page reload

        // Get the filter category from the clicked link
        const filterCategory = this.getAttribute('data-filter');

        // Make an AJAX request to fetch filtered products
        fetch(`/products?category=${filterCategory}`)
          .then(response => {
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            return response.json(); // Parse the response as JSON
          })
          .then(data => {
            console.log('Filtered products:', data);
            
            // Dynamically update the product list
            updateProductsList(data.data);
          })
          .catch(error => {
            console.error('Error fetching products:', error);
          });
      });
    });

    // Function to update the products list in the DOM
    function updateProductsList(products) {
      const productsContainer = document.getElementById('products-container');
      productsContainer.innerHTML = ''; // Clear existing products
      products.forEach(product => {
        const productElement = document.createElement('div');
        productElement.classList.add('product');
        productElement.innerHTML = `
          <h3>${product.title}</h3>
          <p>${product.description}</p>
          <p>${product.price}</p>
        `;
        productsContainer.appendChild(productElement);
      });
    }